{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**,core/**,integrations/**,web/**,public/**"
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:js|css|svg|png|jpg|jpeg|webp|ico|woff2))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 9 * * *"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/index.html",
      "dest": "/index.html"
    },
    {
      "src": "/widget.js",
      "dest": "/widget.js"
    },
    {
      "src": "/vapi-sdk.js",
      "dest": "/vapi-sdk.js"
    },
    {
      "src": "/vapi-call",
      "dest": "/vapi_web_sdk_test.html"
    },
    {
      "src": "/call",
      "dest": "/vapi_web_sdk_test.html"
    },
    {
      "src": "/vapi-test",
      "dest": "/vapi_web_sdk_test.html"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(api|webhook|health|admin|docs|openapi.json)(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
